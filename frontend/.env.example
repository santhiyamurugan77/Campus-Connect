# CampusConnect Automated Testing Credentials Configuration Template
# Copy this file to a new file named '.env' in this directory and populate the actual values.
# WARNING: Do NOT commit the '.env' file containing real secrets to version control.

# Standard Student Account Credentials
TEST_USER_EMAIL=student@campusconnect.test
TEST_USER_PASSWORD=StudentSecurePassword123

# Organizer Account Credentials
TEST_ORGANIZER_EMAIL=organizer@campusconnect.test
TEST_ORGANIZER_PASSWORD=OrganizerSecurePassword123

# Performance Load Testing Target
# Target URL for baseline performance tests (Do NOT target production URL directly)
LOAD_TEST_BASE_URL=http://localhost:8000/api

